# Copy this file to .env and fill in the values. Never commit .env.

# Prometheus started by infra/kwok/create_cluster.sh
PROMETHEUS_URL=http://localhost:9090

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# A specific chat model, e.g. "provider/model-name".
# Avoid "openrouter/free": it picks a different model on each call.
OPENROUTER_MODEL=