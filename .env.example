# Prometheus started by infra/kwok/create_cluster.sh
PROMETHEUS_URL=http://localhost:9090

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# A specific chat model, e.g. "provider/model-name".
OPENROUTER_MODEL=

# Window of the CPU rate() in PromQL. Keep it at least ~4x the Prometheus scrape interval.
CPU_RATE_WINDOW=1m

# Containers of pods younger than this (in real seconds) are not classified:
# a new pod's CPU reads low until the rate window is full.
# Keep it above CPU_RATE_WINDOW (for example, the window plus 60 s).
MIN_POD_AGE_SECONDS=120

REPORT_LOG_PATH = os.environ.get("REPORT_LOG_PATH", "data/processed/reports.jsonl")